# Vercel project environment variables (Settings -> Environment Variables).
# None of these belong in the repo.

# Where the bot's control API is reachable from the internet. HTTPS only:
# the bearer token below travels in this request.
PLANES_VPS_URL=https://planes.losalidirect.com

# Must equal PLANES_CONTROL_TOKEN in the bot's .env on the VPS.
#   openssl rand -hex 24
PLANES_CONTROL_TOKEN=

# The password that opens this console. Anyone with it can send WhatsApp
# messages to the configured recipients, so treat it as a credential.
CONSOLE_PASSWORD=

# Signs the session cookie. Rotating it logs everyone out.
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: how long a login lasts, in hours (default 12).
SESSION_HOURS=12
