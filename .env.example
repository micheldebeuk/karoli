# ---------------------------------------------------------------------------
# Planes WhatsApp bot — copy to .env on the VPS and fill in.
# NEVER commit the real .env (it is gitignored).
# ---------------------------------------------------------------------------

# --- Who receives the planning -------------------------------------------
# Comma-separated. Each entry is either:
#   * an E.164 phone number      -> +34600111222
#   * a group JID                -> 120363000000000000@g.us
# Find a group JID with: npm run status -- --groups
WHATSAPP_RECIPIENTS=+34600111222,+34600333444

# --- Which WhatsApp transport to use --------------------------------------
# baileys : WhatsApp Web multi-device. Free, sends arbitrary formatted text,
#           can post to groups. Needs a one-time phone pairing and a session
#           living on the VPS. This is the default.
# cloud   : Meta WhatsApp Cloud API. Official, but outbound messages started
#           outside a 24h customer window must use an approved template, and
#           it cannot post to groups.
# dry-run : render and log the message, send nothing. Safe for testing.
WHATSAPP_PROVIDER=baileys

# --- baileys provider ------------------------------------------------------
# Directory holding the multi-device auth state. Treat it like a credential.
WHATSAPP_SESSION_DIR=./data/wa-session
# Device label shown in WhatsApp > Linked devices.
WHATSAPP_DEVICE_NAME=Planes Bot
# Fail (rather than hang) if WhatsApp cannot be reached. Milliseconds.
WHATSAPP_CONNECT_TIMEOUT_MS=60000
# Longer budget for `login`, which waits on a human with a phone.
WHATSAPP_PAIR_TIMEOUT_MS=240000
# Consecutive reconnect attempts before giving up and letting pm2 restart us.
WHATSAPP_MAX_RECONNECTS=5
# Reconnect backoff base; doubles per attempt, capped at 30s.
WHATSAPP_RECONNECT_BASE_MS=2000
# Grace period before requesting a pairing code, so the socket can hand-shake.
WHATSAPP_PAIR_HANDSHAKE_MS=3000
# Pause between consecutive sends, so a burst looks less bot-like.
WHATSAPP_SEND_DELAY_MS=900

# --- cloud provider (only if WHATSAPP_PROVIDER=cloud) ----------------------
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_API_VERSION=v21.0
# Used when the recipient is outside the 24h free-form window.
WA_CLOUD_TEMPLATE_NAME=planes_fin_de_semana
WA_CLOUD_TEMPLATE_LANG=es

# --- Who is allowed to vote, and under which name --------------------------
# Maps a phone number to the sheet's vote column owner. Numbers not listed here
# can read the planning but their votes are ignored.
PLANNING_VOTERS=+34600111222=Olivier,+34600333444=Karina

# --- Control API (what the web console talks to) ---------------------------
# Runs inside the `listen` process, because only one process may hold the
# WhatsApp session. Everything else — the weekly cron, the Vercel site — asks
# it to send rather than opening its own connection.
PLANES_CONTROL_ENABLED=1
# Keep this on loopback and terminate TLS in front of it (nginx/caddy), exactly
# like api.losalidirect.com. The token is the only credential.
PLANES_CONTROL_HOST=127.0.0.1
PLANES_CONTROL_PORT=3010
# Required, minimum 24 chars:  openssl rand -hex 24
PLANES_CONTROL_TOKEN=
# Throttle real sends so a stuck client cannot spam the chat.
PLANES_CONTROL_SEND_LIMIT=6
PLANES_CONTROL_SEND_WINDOW_MS=900000

# --- Route A: answers written by Claude, on your SUBSCRIPTION ---------------
# The bot shells out to Claude Code headless (`claude -p`). Authenticate once,
# as the user pm2 runs as:
#     claude setup-token          # its help says: "requires Claude subscription"
#     claude auth status          # must report "authMethod": "oauth_token"
# Never set ANTHROPIC_API_KEY here — it can shadow the OAuth credential and
# silently move you onto per-token API billing. The worker strips it anyway.
PLANES_ASK_ENABLED=0
PLANES_ASK_MODEL=sonnet
# In a group the bot only answers when named ("Claude, ¿...?"). A one-to-one
# chat with a listed voter needs no prefix.
PLANES_ASK_PREFIX=claude
PLANES_ASK_PREFIX_IN_DIRECT=0
# Usage comes out of the same pool as your own Claude Code work — cap it.
PLANES_ASK_DAILY_LIMIT=25
PLANES_ASK_TICK_MS=30000
PLANES_ASK_TIMEOUT_MS=300000
PLANES_ASK_MAX_ANSWER_CHARS=1200

# --- Where the planning comes from ----------------------------------------
# fixture       : read fixtures/planning.json (a snapshot of the sheet).
# pushed        : Route B — a scheduled Claude Routine reads the sheet with your
#                 own Google Drive connector and POSTs it to
#                 /api/planning/import. No Google credentials on the VPS.
# google-sheets : read the sheet directly from here. NOT IMPLEMENTED (and Route
#                 B makes it largely unnecessary).
PLANNING_SOURCE=fixture
PLANNING_PUSHED_FILE=./data/planning-pushed.json
PLANNING_SHEET_ID=1Nvnh1YvoEMrZgFIpInuQNvqck8vX6fN2XNKva7KW2QY
PLANNING_SHEET_RANGE=A1:M

# --- Behaviour -------------------------------------------------------------
TZ=Europe/Madrid
# Only send plans whose day falls in the upcoming weekend. Set to 0 to send all.
PLANNING_UPCOMING_ONLY=1
# Set to 1 to render but never actually send, whatever the provider.
DRY_RUN=0
